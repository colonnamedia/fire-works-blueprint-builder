{
  "name": "Business",
  "type": "object",
  "properties": {
    "business_name": {
      "type": "string",
      "title": "Business Name"
    },
    "business_type": {
      "type": "string",
      "title": "Business Type"
    },
    "storefront_type": {
      "type": "string",
      "enum": [
        "storefront",
        "non-storefront",
        "hybrid"
      ],
      "title": "Storefront Type"
    },
    "industry": {
      "type": "string",
      "title": "Industry"
    },
    "main_offer": {
      "type": "string",
      "title": "Main Offer"
    },
    "secondary_offer": {
      "type": "string",
      "title": "Secondary Offer"
    },
    "target_audience": {
      "type": "string",
      "title": "Target Audience"
    },
    "service_area": {
      "type": "string",
      "title": "Service Area"
    },
    "average_ticket_value": {
      "type": "number",
      "title": "Average Ticket Value"
    },
    "main_goal": {
      "type": "string",
      "title": "Main Goal"
    },
    "secondary_goal": {
      "type": "string",
      "title": "Secondary Goal"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "active",
        "archived"
      ],
      "title": "Status"
    },
    "has_website": {
      "type": "boolean",
      "title": "Has Website"
    },
    "website_url": {
      "type": "string",
      "title": "Website URL"
    },
    "needs_landing_page": {
      "type": "boolean",
      "title": "Needs Landing Page"
    },
    "has_booking_form": {
      "type": "boolean",
      "title": "Has Booking Form"
    },
    "has_lead_form": {
      "type": "boolean",
      "title": "Has Lead Form"
    },
    "has_email_capture": {
      "type": "boolean",
      "title": "Has Email Capture"
    },
    "has_crm": {
      "type": "boolean",
      "title": "Has CRM"
    },
    "has_online_checkout": {
      "type": "boolean",
      "title": "Has Online Checkout"
    },
    "conversion_strength": {
      "type": "string",
      "enum": [
        "weak",
        "moderate",
        "strong"
      ],
      "title": "Conversion Strength"
    },
    "lead_response_speed": {
      "type": "string",
      "enum": [
        "slow",
        "moderate",
        "fast"
      ],
      "title": "Lead Response Speed"
    },
    "selected_channels": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Selected Channels"
    },
    "monthly_marketing_budget": {
      "type": "number",
      "title": "Monthly Marketing Budget"
    },
    "weekly_time_available": {
      "type": "number",
      "title": "Weekly Time Available (hours)"
    },
    "who_is_doing_marketing": {
      "type": "string",
      "title": "Who Does Marketing"
    },
    "can_create_content": {
      "type": "boolean",
      "title": "Can Create Content In-House"
    },
    "can_run_ads": {
      "type": "boolean",
      "title": "Can Run Ads"
    },
    "can_follow_up_quickly": {
      "type": "boolean",
      "title": "Can Follow Up Quickly"
    },
    "email_list_size": {
      "type": "number",
      "title": "Email List Size"
    },
    "customer_list_size": {
      "type": "number",
      "title": "Customer List Size"
    },
    "need_fast_leads": {
      "type": "boolean",
      "title": "Need Fast Leads"
    },
    "want_lowest_cost": {
      "type": "boolean",
      "title": "Want Lowest Cost Options"
    },
    "want_long_term_growth": {
      "type": "boolean",
      "title": "Want Long-Term Growth"
    },
    "need_better_followup": {
      "type": "boolean",
      "title": "Need Better Follow-Up"
    },
    "need_better_conversion": {
      "type": "boolean",
      "title": "Need Better Conversion"
    },
    "want_automation": {
      "type": "boolean",
      "title": "Want Automation"
    },
    "want_clear_homebase": {
      "type": "boolean",
      "title": "Want Clear Home Base Plan"
    },
    "strategy_style": {
      "type": "string",
      "enum": [
        "simple",
        "moderate",
        "aggressive"
      ],
      "title": "Strategy Style"
    },
    "payment_status": {
      "type": "string",
      "enum": [
        "unpaid",
        "paid",
        "admin_free"
      ],
      "title": "Payment Status"
    }
  },
  "required": [
