{
  "name": "BlueprintBranch",
  "type": "object",
  "properties": {
    "draft_id": {
      "type": "string",
      "title": "Draft ID"
    },
    "branch_name": {
      "type": "string",
      "title": "Branch Name"
    },
    "purpose": {
      "type": "string",
      "title": "Purpose"
    },
    "objective": {
      "type": "string",
      "title": "Objective"
    },
    "time_percent": {
      "type": "number",
      "title": "Time %"
    },
    "cost_percent": {
      "type": "number",
      "title": "Cost %"
    },
    "priority_level": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "title": "Priority Level"
    },
    "owner": {
      "type": "string",
      "enum": [
        "me",
        "team_member",
        "contractor",
        "agency",
        "unassigned"
      ],
      "title": "Owner"
    },
    "status": {
      "type": "string",
      "enum": [
        "not_started",
        "active",
        "needs_work",
        "testing",
        "strong",
        "paused"
      ],
      "title": "Status"
    },
    "metric_to_watch": {
      "type": "string",
      "title": "Metric to Watch"
    },
    "what_to_adjust_if_weak": {
      "type": "string",
      "title": "What to Adjust if Weak"
    },
    "review_note": {
      "type": "string",
      "title": "5-7 Day Review Note"
    },
    "while_waiting_action": {
      "type": "string",
      "title": "While Waiting Action"
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    },
    "sort_order": {
      "type": "number",
      "title": "Sort Order"
    },
    "visible": {
      "type": "boolean",
      "title": "Visible"
    }
  },
  "required": [
    "draft_id",
    "branch_name"
  ]
}